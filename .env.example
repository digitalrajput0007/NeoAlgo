APP_ENV=production
NEOALGO_ENV=production
NEOALGO_MODE=PAPER
LIVE_TRADING_ENABLED=false

POSTGRES_PASSWORD=your_strong_database_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_strong_database_password_here@db:5432/algo_trader

TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=your_session_string
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=your_channel_id

BROKER_API_KEY=your_broker_api_key
BROKER_API_SECRET=your_broker_api_secret
BROKER_ACCESS_TOKEN=your_broker_token

# Kotak Neo API Configuration (Read-Only Mode)
KOTAK_NEO_ENVIRONMENT=prod
KOTAK_NEO_CONSUMER_KEY=your_consumer_key_here
KOTAK_NEO_CONSUMER_SECRET=your_consumer_secret_here
KOTAK_NEO_MOBILE_NUMBER=your_registered_mobile
KOTAK_NEO_UCC=your_client_code
KOTAK_NEO_MPIN=your_mpin
KOTAK_NEO_TOTP_SECRET=your_base32_totp_secret

NEOALGO_ADMIN_USERNAME=admin
NEOALGO_ADMIN_PASSWORD_HASH=your_password_hash_here
NEOALGO_AUTH_SECRET=your_jwt_secret_here
